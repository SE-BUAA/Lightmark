# =====================================================================
# 前端运行镜像（多架构）—— 由 CI 流水线使用
#
# dist 由 CI 在原生 x86 环境构建后放入构建上下文（dist/）。
# nginx.spa.conf 支持 Vue Router history 模式（次级路由刷新回退 index.html）。
# 静态资源与平台无关，amd64 / arm64 共用同一份产物。
#
# 本地开发 / docker compose 仍使用 frontend/Dockerfile.nginx（源码构建）。
# =====================================================================
FROM nginx:1.27-alpine

COPY dist /usr/share/nginx/html
COPY nginx.spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
