# =====================================================================
# 后端运行镜像（多架构）—— 由 CI 流水线使用
#
# jar 由 CI 在原生 x86 环境构建后放入构建上下文（app.jar）。
# Java 字节码与平台无关，amd64 / arm64 共用同一份产物，
# 多架构构建时无需在 QEMU 下重复编译，速度提升 5~10 倍。
#
# 本地开发 / docker compose 仍使用 backend/Dockerfile（源码构建）。
# =====================================================================
FROM eclipse-temurin:17-jre

WORKDIR /app

COPY app.jar /app/app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
