# =====================================================================
# Lightmark 环境变量模板
# 用法：cp .env.example .env 并填写真实值（.env 不入库）
# 适用场景：本地 Docker Compose 开发 / 服务器 Kubernetes 部署
# =====================================================================

# ===== MySQL（数据库容器初始化，首次启动自动读入 database/*.sql）=====
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=lightmark
MYSQL_USER=lightmark
MYSQL_PASSWORD=change-me
# 宿主机映射端口（宿主机已有 MySQL 时改为 3307 等空闲端口）
MYSQL_PORT=3306

# ===== 应用数据库连接 =====
# Docker Compose 与 Kubernetes 下 DB_HOST 均为服务名 mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=lightmark
DB_USER=lightmark
DB_PASSWORD=change-me

# ===== JWT =====
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=lightmark
JWT_EXPIRE_MINUTES=120

# ===== AI（DeepSeek/OpenAI 兼容接口）=====
DEEPSEEK_API_KEY=sk-your-deepseek-key
AI_API_URL=https://api.deepseek.com/chat/completions
AI_API_KEY=sk-your-ai-key
AI_MODEL=deepseek-v4-flash

OPENAI_API_KEY=
OBJECT_STORAGE_BASE_URL=https://objectstorage.ap-tokyo-1.oraclecloud.com/p/lalala/n/guesswhat/b/ortus-bucket/o/

# ===== 邮件（可选，启用邮箱验证码时填写）=====
AUTH_MAIL_USERNAME=
AUTH_MAIL_PASSWORD=
AUTH_MAIL_FROM_EMAIL=

# ===== 镜像与编排（Docker Compose 本地/单机）=====
# 本地直接构建：IMAGE_TAG=local；CI/CD 流水线会自动注入版本号（如 1.0.123）
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=lightmark
IMAGE_TAG=local
# 无证书的本地环境改用纯 HTTP：NGINX_CONF=./deploy/nginx.http.conf
NGINX_CONF=./deploy/nginx.conf
CERT_DIR=./deploy/certs
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ===== Kubernetes 部署 =====
# Ingress 域名（流水线通过 GitHub 变量 INGRESS_HOST 传入，缺省用此值）
INGRESS_HOST=lightmark.ortus.top
